{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfdevspotifycenind"
		},
		"LS_ADLS_Spotify_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_Spotify'"
		},
		"LS_AzureSqlDatabase_Spotify_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSqlDatabase_Spotify'"
		},
		"LS_ADLS_Spotify_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevspotifycenind.dfs.core.windows.net/"
		},
		"LS_AzureSqlDatabase_Spotify_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqldevazrcenind.database.windows.net"
		},
		"LS_AzureSqlDatabase_Spotify_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "spotifydbdevazrcenind"
		},
		"LS_AzureSqlDatabase_Spotify_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfdevspotifycenind_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_Spotify_accountKey": {
						"value": "[parameters('LS_ADLS_Spotify_accountKey')]"
					},
					"LS_AzureSqlDatabase_Spotify_password": {
						"value": "[parameters('LS_AzureSqlDatabase_Spotify_password')]"
					},
					"LS_ADLS_Spotify_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Spotify_properties_typeProperties_url')]"
					},
					"LS_AzureSqlDatabase_Spotify_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSqlDatabase_Spotify_properties_typeProperties_server')]"
					},
					"LS_AzureSqlDatabase_Spotify_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSqlDatabase_Spotify_properties_typeProperties_database')]"
					},
					"LS_AzureSqlDatabase_Spotify_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSqlDatabase_Spotify_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}